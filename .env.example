# Copy to .env and fill in. Empty values count as unset. Apply every change with:
#   docker compose up -d
#
# Any variable can instead be read from a file: set NAME_FILE to its path inside the container, e.g.
# ONEPLAY_PASSWORD_FILE=/run/secrets/oneplay_password for a Docker secret. Values in .env are
# visible to anyone who can run `docker inspect`; files are not. Put a value containing $ in
# single quotes.

# --- Network --------------------------------------------------------------
# The address Sonarr and Radarr use to reach Bohemarr (origin only, no path).
PUBLIC_URL=http://bohemarr:8787
# Host address and port the service is published on. 127.0.0.1 keeps it local to this machine.
PUBLISH_ADDRESS=127.0.0.1
PUBLISH_PORT=8787
TZ=Europe/Prague

# --- Downloads ------------------------------------------------------------
# Host directory for completed downloads.
DOWNLOADS_PATH=./downloads
# The same directory inside the containers. Use the path Sonarr and Radarr mount it at, e.g.
# /data/downloads when they mount the host's data directory at /data. Hardlinks also need the
# library on the same filesystem and in the same mount.
DOWNLOADS_DIR=/downloads
# Download-client categories, comma-separated; each becomes a subdirectory of the downloads.
CATEGORIES=tv,movies
# Simultaneous downloads (1-32).
CONCURRENCY=2

# --- Security -------------------------------------------------------------
# At least 32 characters. Leave empty to generate one and store it in /config/api-key.
API_KEY=

# --- Providers ------------------------------------------------------------
# The enabled providers, comma-separated; every other provider is disabled. Leave empty to enable
# every public provider, and every account provider whose credentials are set. Known providers:
# ceskatelevize, streamcz, iprima, oneplay, novaplus, tncz, markizaplus, markizavoyo, jojplay,
# sledovanitv, tvprimadoma, tvbarrandov, tvautosalon, stvr, html5, youtube, direct
PROVIDERS=ceskatelevize,streamcz
# Account credentials. Provider settings are named <PROVIDER>_<SETTING>.
IPRIMA_USERNAME=
IPRIMA_PASSWORD=
ONEPLAY_USERNAME=
ONEPLAY_PASSWORD=
MARKIZAVOYO_USERNAME=
MARKIZAVOYO_PASSWORD=
JOJPLAY_USERNAME=
JOJPLAY_PASSWORD=
SLEDOVANITV_USERNAME=
SLEDOVANITV_PASSWORD=
TVBARRANDOV_USERNAME=
TVBARRANDOV_PASSWORD=
# Optional account settings; the provider chooses when they are empty.
ONEPLAY_ACCOUNT_ID=
ONEPLAY_PROFILE=
ONEPLAY_PROFILE_PIN=
IPRIMA_PROFILE=
IPRIMA_DEVICE_ID=
# A paired SledovaniTV device, used before logging in with the username and password.
SLEDOVANITV_DEVICE_ID=
SLEDOVANITV_PROFILE=
SLEDOVANITV_COOKIES=
# A Voyo session cookie containing votoken, used before logging in.
MARKIZAVOYO_COOKIES=
# YouTube: client TV, ANDROID, WEB or IOS (default), and an optional signed-in session.
YOUTUBE_CLIENT=
YOUTUBE_COOKIES=
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
YOUTUBE_PLAYER_ID=
# Lists and objects (the static catalogue of the direct provider, request headers of html5 and
# direct) go in /config/config.json; see config.example.json.

# --- Sonarr and Radarr ----------------------------------------------------
# With a URL and API key (Settings > General), Bohemarr configures the application at every start:
# a Torznab indexer and a qBittorrent download client named Bohemarr, a Delay Profile without
# torrent delay for the tag "bohemarr", and the root folder. Leave both empty to configure it by hand.
SONARR_URL=
SONARR_API_KEY=
SONARR_CATEGORY=tv
# Library path as Sonarr sees it, e.g. /data/media/tv. Optional.
SONARR_ROOT_FOLDER=
RADARR_URL=
RADARR_API_KEY=
RADARR_CATEGORY=movies
RADARR_ROOT_FOLDER=
# true: Sonarr and Radarr move completed downloads into the library and remove them from Bohemarr.
# false: they copy or hardlink them, and the downloads stay until removed.
ARR_REMOVE_COMPLETED=true

# --- Publishing to Vltava ---------------------------------------------------
# Every file Sonarr or Radarr imports from a Bohemarr download of a listed provider is uploaded to
# the Vltava tracker with its `vltava` CLI (into moderation, unless the account may skip it) and
# seeded by a dedicated rqbit. Sonarr and Radarr report imports through a Webhook connection
# Bohemarr creates when SONARR_URL/RADARR_URL are set. Leave VLTAVA_URL and VLTAVA_TOKEN empty to
# disable publishing. Enabling it needs the Compose overlay:
#COMPOSE_FILE=compose.yaml:compose.vltava.yaml
# Vltava source directory; the image builds the `vltava` CLI from it.
VLTAVA_SOURCE=
# The host media library, and its path inside Sonarr and Radarr (e.g. /data when they report
# /data/tvshows/...). Bohemarr and vltava-seeder mount it at the same path.
MEDIA_PATH=
MEDIA_DIR=
VLTAVA_URL=
# A personal API token with the upload scope (Vltava: Profil > API tokeny).
VLTAVA_TOKEN=
# Providers whose releases are published, comma-separated. List only sources you may redistribute.
VLTAVA_PROVIDERS=
# Where each canonical tree and its .torrent are built and seeded from. Must lie inside MEDIA_DIR for
# hardlinks, and outside a shared rqbit's community seedbox folder (SEEDBOX_SAVE_PATH in Vltava).
VLTAVA_OUT_DIR=
# hardlink (default; the tree must be on the library's filesystem), symlink or copy.
VLTAVA_LINK=hardlink
# Release group in canonical names (letters and digits). Optional.
VLTAVA_GROUP=
VLTAVA_ANONYMOUS=false
# The rqbit server that seeds published torrents. Either Vltava's shared rqbit (its community
# seedbox), or one run here as vltava-seeder with COMPOSE_PROFILES=seeder:
#COMPOSE_PROFILES=seeder
VLTAVA_SEEDER_URL=http://vltava-seeder:3030
# Its HTTP API login, as username:password. Bohemarr and vltava-seeder both read it.
VLTAVA_SEEDER_USERPASS=
# Host port of its Web UI (/web/), and the port peers connect to (must be reachable from the internet).
VLTAVA_SEEDER_PUBLISH_PORT=3030
VLTAVA_TORRENTING_PORT=6881
